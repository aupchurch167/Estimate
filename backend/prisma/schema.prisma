// Quill — Prisma schema
//
// Phase 0.1 placeholder. The complete schema (21 models, 15 enums) lands in
// Phase 0.3 per quill-build-playbook.md. Until then this file only declares
// the generator and datasource so `prisma generate` works.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
