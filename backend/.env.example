# Quill backend environment.
#
# Copy to backend/.env and fill in real values. Every variable below is
# validated on startup via backend/src/lib/env.ts; missing required values
# produce a friendly error and exit 1 before the server boots.
#
# Dummy values here are safe to commit.

# ─── Runtime ────────────────────────────────────────────────────────────────

# Node mode. One of: development, production, test.
NODE_ENV=development

# Express listens here.
PORT=4000

# Frontend base URL (used in email links, CORS, redirects).
APP_URL=http://localhost:5173

# API base URL (used in email links and any self-referencing URLs).
API_URL=http://localhost:4000

# Logger level. One of: debug, info, warn, error.
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────

# Postgres connection string. In dev this is a local Postgres or a Neon dev
# branch URL; in prod this is the Neon production branch.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quill

# ─── Auth ───────────────────────────────────────────────────────────────────

# Random 64-character string for signing access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string-________________________

# Random 64-character string for signing refresh tokens. Must differ from the
# access secret.
JWT_REFRESH_SECRET=change-me-too-a-different-64-char-random-string-_____________

# Access token TTL. Express-style duration string (e.g. 15m, 1h, 30s).
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token TTL.
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt hashing rounds. 12 is the production target; lower in dev for speed.
BCRYPT_ROUNDS=12

# ─── AI (Anthropic) ─────────────────────────────────────────────────────────

# Anthropic API key. Format: sk-ant-…
ANTHROPIC_API_KEY=sk-ant-development-placeholder

# Primary Claude model used for reasoning-heavy runs (line-item generation,
# follow-up actions).
AI_MODEL_PRIMARY=claude-sonnet-4-6

# Light Claude model used for cheap classifier-style runs.
AI_MODEL_LIGHT=claude-haiku-4-5-20251001

# Default monthly AI cost cap, in USD, applied to new orgs that don't set
# their own. MAC's seeded org overrides this to 200.
DEFAULT_MONTHLY_AI_CAP_USD=100

# ─── Email (SendGrid) ───────────────────────────────────────────────────────

# SendGrid API key. Format: SG.…
SENDGRID_API_KEY=SG.development-placeholder

# Address transactional emails are sent from.
SENDGRID_FROM_EMAIL=noreply@quill.app

# Display name shown in the email "From" field.
SENDGRID_FROM_NAME=Quill

# ─── File storage (DigitalOcean Spaces, S3-compatible) ──────────────────────

# Spaces credentials.
SPACES_KEY=do-spaces-access-key
SPACES_SECRET=do-spaces-secret-key

# Spaces region endpoint, e.g. https://nyc3.digitaloceanspaces.com
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Bucket name.
SPACES_BUCKET=quill-dev

# Region code, e.g. nyc3, sfo3.
SPACES_REGION=nyc3

# How long signed upload URLs remain valid, in seconds.
SIGNED_UPLOAD_EXPIRES_SECONDS=900

# ─── Observability ──────────────────────────────────────────────────────────

# Sentry DSN. Production-only — leave blank in dev.
SENTRY_DSN=

# ─── Feature flags ──────────────────────────────────────────────────────────

# Whether self-serve org signup is open. Disable before customer #2 if needed.
ENABLE_SIGNUP=true

# ─── Helm Core integration ───────────────────────────────────────────────────

# Set to "true" to enable Core API calls (accounts, deals, properties, vendors).
# When false (the default), Quill runs fully standalone with no Core dependency.
HELM_CORE_INTEGRATION=false

# Base URL of the Core API. Required when HELM_CORE_INTEGRATION=true.
# Run Core locally with: pnpm dev --filter @helm/core (listens on :3010).
CORE_API_URL=http://localhost:3010

# A real user UUID from the Core database. Used in development to bypass Auth.js
# — the Core dev server accepts x-helm-test-user-id / x-helm-test-org-slug headers.
CORE_DEV_USER_ID=
