# Quill backend environment.
# Phase 0.1 placeholder. Phase 0.2 fills out every variable from the brief
# Section 7, with full per-variable comments and Zod validation on startup.

# Postgres connection string (Neon dev branch or local Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quill

# Process port — Express listens here.
PORT=4000

# development | production
NODE_ENV=development
