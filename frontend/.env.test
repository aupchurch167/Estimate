# Frontend test-mode environment.
#
# Vitest auto-loads this file when running in test mode (its default).
# Vite only exposes VITE_* values from .env* files via import.meta.env,
# so test runs need this file even though src/lib/env.ts validates the
# values at import time. CI containers and fresh checkouts both pick
# this up automatically — there's nothing to copy or generate.
#
# These are localhost defaults — safe to commit. Real values for `dev`
# go in frontend/.env (gitignored).
VITE_API_URL=http://localhost:4000
VITE_APP_URL=http://localhost:5173
VITE_SENTRY_DSN=
