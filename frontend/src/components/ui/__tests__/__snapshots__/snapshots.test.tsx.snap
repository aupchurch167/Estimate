      <button
        class="inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-primary text-text-inverse border border-primary hover:bg-primary-hover hover:border-primary-hover h-9 px-4 text-[14px]"
