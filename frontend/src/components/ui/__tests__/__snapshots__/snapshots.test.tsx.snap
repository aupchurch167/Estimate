exports[`Modal snapshots > open with footer 1`] = `
<div
  class="fixed inset-0 z-40 flex items-center justify-center bg-text-primary/40 px-4 animate-in fade-in duration-fast"
  data-testid="modal-backdrop"
>
  <div
    aria-label="Confirm"
    aria-modal="true"
    class="flex w-full flex-col rounded-lg border border-border-primary bg-bg-primary shadow-lg max-w-[640px] max-h-[calc(100vh-32px)]"
    data-testid="modal"
    role="dialog"
    tabindex="-1"
  >
    <header
      class="flex items-start justify-between gap-4 border-b border-border-primary px-6 py-4"
    >
      <div
        class="min-w-0 flex-1"
      >
        <h2
          class="text-[18px] font-medium leading-7 text-text-primary"
        >
          Confirm
        </h2>
      </div>
      <button
        aria-label="Close"
        class="rounded-md p-1 text-text-tertiary hover:bg-bg-tertiary hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus"
        data-testid="modal-close"
        type="button"
      >
        <svg
          aria-hidden="true"
          fill="none"
          height="20"
          viewBox="0 0 20 20"
          width="20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M6 6L14 14M14 6L6 14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.6"
          />
        </svg>
      </button>
    </header>
    <div
      class="flex-1 overflow-auto px-6 py-5"
    >
      Body
    </div>
    <footer
      class="flex items-center justify-end gap-2 border-t border-border-primary px-6 py-4"
    >
      <button
        class="inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-bg-primary text-text-primary border border-border-secondary hover:bg-bg-tertiary h-9 px-4 text-[14px]"
        data-size="md"
        data-variant="secondary"
        type="button"
      >
        Cancel
