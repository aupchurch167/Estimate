# Quill frontend environment.
#
# Copy to frontend/.env. Vite only exposes vars prefixed with VITE_ to the
# browser. Validation runs at module load via frontend/src/lib/env.ts.

# Base URL of the backend API. The Axios client points its requests here.
VITE_API_URL=http://localhost:4000

# Public app URL. Used for any self-referencing links rendered in the UI
# (rare in MVP — most navigation is relative).
VITE_APP_URL=http://localhost:5173

# Optional: Sentry DSN for browser error reporting. Leave empty in dev.
VITE_SENTRY_DSN=

# Enable Core API integration. When true, the estimate form shows searchable
# account and deal pickers backed by /api/core/*. Must match the backend flag.
VITE_HELM_CORE_INTEGRATION=false
